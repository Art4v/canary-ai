# ---------------------------------------------------------------------------
# data.py / backtest.py environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# REWIND_HOURS
# How many hours to rewind the clock when fetching data.
#
#   0        — live mode: always fetch the most recent 1-minute bar.
#   <number> — rewind mode: treat (now - REWIND_HOURS) as "current time"
#              and replay historical minute bars from that point forward.
#              Each 60-second poll advances the simulated clock by 1 minute,
#              letting you test prediction.cpp against real past data while
#              markets are closed.
#
# Examples:
#   REWIND_HOURS=0      live data
#   REWIND_HOURS=6.5    rewind 6 hours 30 minutes (useful after US close)
#   REWIND_HOURS=24     replay yesterday's session
REWIND_HOURS=0

# INITIAL_CASH
# Starting portfolio cash balance in USD for the backtester.
# This is the amount of simulated money available at the start of a run.
#
# Examples:
#   INITIAL_CASH=1000     start with $1,000
#   INITIAL_CASH=10000    start with $10,000
INITIAL_CASH=1000

# TICKERS
# Comma-separated list of stock tickers to track and trade.
# Both data.py and backtest.py read this variable so they stay in sync.
# Thinly-traded or OTC symbols are fine — if yfinance returns no data for
# a ticker, the backtester simply skips it until data appears.
#
# Examples:
#   TICKERS=AAPL,TSLA                two tickers only
#   TICKERS=AAPL,TSLA,JPM,PLTR,CELS default universe
TICKERS=AAPL,TSLA,JPM,PLTR,CELS
