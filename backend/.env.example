# Finnhub API key — get one free at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Shift the app clock N hours into the past so yfinance and Finnhub
# return data from that earlier window.  Useful for testing outside
# of market hours.  Set to 0 or leave unset for real-time behaviour.
TIME_REWIND_HOURS=0

# Supabase — get your URL and anon key from https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
